MiscTab:CreateToggle({
    Name = "Fly",
    CurrentValue = false,
    Flag = "Fly",
    Callback = function(v)
        _G.Fly = v
        if v then
            task.spawn(function()
                local Players = game:GetService("Players")
                local Workspace = game:GetService("Workspace")
                local LocalPlayer = Players.LocalPlayer
                local PlayerModule = require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule"))
                local ControlModule = PlayerModule:WaitForChild("ControlModule")
                
                while _G.Fly do
                    pcall(function()
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        
                        if hrp then
                            if not hrp:FindFirstChild("BodyGyro") then
                                local bg = Instance.new("BodyGyro", hrp)
                                bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
                                bg.P = 9e4
                                bg.CFrame = hrp.CFrame
                            end
                            
                            if not hrp:FindFirstChild("BodyVelocity") then
                                local bv = Instance.new("BodyVelocity", hrp)
                                bv.Velocity = Vector3.new(0, 0, 0)
                                bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
                            end
                            
                            local moveVec = ControlModule:GetMoveVector()
                            local bg = hrp:FindFirstChild("BodyGyro")
                            local bv = hrp:FindFirstChild("BodyVelocity")
                            
                            if bg and bv then
                                bg.CFrame = CFrame.new(hrp.Position, hrp.Position + Workspace.CurrentCamera.CFrame.LookVector)
                                bv.Velocity = Vector3.new()
                                
                                if moveVec.X ~= 0 then
                                    bv.Velocity = bv.Velocity + Workspace.CurrentCamera.CFrame.RightVector * (moveVec.X * _G.FlySpeed)
                                end
                                if moveVec.Z ~= 0 then
                                    bv.Velocity = bv.Velocity - Workspace.CurrentCamera.CFrame.LookVector * (moveVec.Z * _G.FlySpeed)
                                end
                            end
                        end
                    end)
                    task.wait()
                end
                
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if hrp:FindFirstChild("BodyGyro") then hrp.BodyGyro:Destroy() end
                    if hrp:FindFirstChild("BodyVelocity") then hrp.BodyVelocity:Destroy() end
                end
            end)
        end
        Notify(v and "Fly ON" or "Fly OFF")
    end,
})

