            task.spawn(function()
                while _G.AutoGrenade do
                    pcall(function()
                        local Workspace = game:GetService("Workspace")
                        local Players = game:GetService("Players")
                        local LocalPlayer = Players.LocalPlayer
                        
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            local OldCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
                            
                            if not HasTool("Grenade") then
                                repeat 
                                    task.wait()
                                    if Workspace:FindFirstChild("Effects") then
                                        for _, item in pairs(Workspace.Effects:GetChildren()) do
                                            if item.Name == "DroppedGrenade" and item:FindFirstChild("Handle") then
                                                LocalPlayer.Character.HumanoidRootPart.CFrame = item.Handle.CFrame
                                                break
                                            end
                                        end
                                    end
                                until HasTool("Grenade")
                                task.wait(0.3)
                                LocalPlayer.Character.HumanoidRootPart.CFrame = OldCFrame
                            end
                        end
                    end)
                    task.wait()
                end
            end)
        end
        Notify(v and "Auto Grenade ON" or "Auto Grenade OFF")
    end,
})

